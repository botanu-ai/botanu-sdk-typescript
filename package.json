{
  "name": "@botanu/sdk",
  "version": "0.1.0",
  "description": "OpenTelemetry-native cost attribution for AI workflows",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./tracking/llm": {
      "import": "./dist/esm/tracking/llm.js",
      "require": "./dist/cjs/tracking/llm.js"
    },
    "./tracking/data": {
      "import": "./dist/esm/tracking/data.js",
      "require": "./dist/cjs/tracking/data.js"
    },
    "./middleware": {
      "import": "./dist/esm/sdk/middleware.js",
      "require": "./dist/cjs/sdk/middleware.js"
    },
    "./integrations/retry": {
      "import": "./dist/esm/integrations/retry.js",
      "require": "./dist/cjs/integrations/retry.js"
    },
    "./register": {
      "import": "./dist/esm/register.js",
      "require": "./dist/cjs/register.js"
    }
  },
  "sideEffects": [
    "./dist/esm/register.js",
    "./dist/cjs/register.js"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/botanu-ai/botanu-sdk-typescript.git"
  },
  "homepage": "https://github.com/botanu-ai/botanu-sdk-typescript#readme",
  "bugs": {
    "url": "https://github.com/botanu-ai/botanu-sdk-typescript/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opentelemetry",
    "observability",
    "llm",
    "ai",
    "cost-attribution",
    "botanu"
  ],
  "author": "Botanu Authors",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@opentelemetry/api": "^1.7.0"
  },
  "dependencies": {
    "@opentelemetry/core": "^1.22.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.49.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.49.0",
    "@opentelemetry/resources": "^1.22.0",
    "@opentelemetry/sdk-logs": "^0.49.0",
    "@opentelemetry/sdk-trace-base": "^1.22.0",
    "@opentelemetry/sdk-trace-node": "^1.22.0",
    "@opentelemetry/semantic-conventions": "^1.22.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.7.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
